{
  "ConnectionStrings": {
    "JobAlignDb": "Server=localhost;Database=JobAlign;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Ai": {
    "Provider": "Gemini",
    "Model": "gemini-3.6-flash",
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta",
    "TimeoutSeconds": 30,
    "MaxOutputTokens": 8192,
    "ThinkingBudget": null
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
