@{ ViewData["Title"] = "Check your email"; }

<h1 class="h3">Check your email</h1>
<p class="text-muted">
    If that address has an account, a password reset link is on its way.
</p>
<div class="alert alert-warning">
    <strong>Development build:</strong> email delivery is not configured. The reset link is
    written to the application log instead of being sent.
</div>
<a class="btn btn-secondary" asp-action="Login">Back to sign in</a>
