@model PostingListViewModel
@{
    ViewData["Title"] = "My postings";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="h3 mb-0">My postings</h1>
        <p class="text-muted small mb-0">Manage, filter, and track all your captured job opportunities.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary btn-sm"
           asp-action="Index"
           asp-route-includeArchived="@(!Model.IncludeArchived)"
           asp-route-workMode="@Model.WorkMode"
           asp-route-location="@Model.Location"
           asp-route-minExp="@Model.MinExperience"
           asp-route-maxExp="@Model.MaxExperience"
           asp-route-sortBy="@Model.SortBy"
           asp-route-sortOrder="@Model.SortOrder">
            @(Model.IncludeArchived ? "Hide archived" : "Show archived")
        </a>
        <a class="btn btn-primary btn-sm" asp-action="Create">Add a posting</a>
    </div>
</div>

@* Filter and Sort Form (FR-50, FR-51) *@
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body bg-light rounded">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <input type="hidden" name="includeArchived" value="@Model.IncludeArchived.ToString()" />

            <div class="col-12 col-sm-6 col-md-3 col-lg-2">
                <label class="form-label small fw-semibold mb-1">Work Mode</label>
                <select name="workMode" class="form-select form-select-sm">
                    <option value="">All modes</option>
                    <option value="@RemotePolicy.Remote" selected="@(Model.WorkMode == RemotePolicy.Remote)">Remote</option>
                    <option value="@RemotePolicy.Hybrid" selected="@(Model.WorkMode == RemotePolicy.Hybrid)">Hybrid</option>
                    <option value="@RemotePolicy.Onsite" selected="@(Model.WorkMode == RemotePolicy.Onsite)">Onsite</option>
                    <option value="@RemotePolicy.Unclear" selected="@(Model.WorkMode == RemotePolicy.Unclear)">Unclear</option>
                </select>
            </div>

            <div class="col-12 col-sm-6 col-md-3 col-lg-2">
                <label class="form-label small fw-semibold mb-1">Location</label>
                <input type="text" name="location" value="@Model.Location" class="form-control form-control-sm" placeholder="City or Country..." />
            </div>

            <div class="col-6 col-sm-3 col-md-2 col-lg-2">
                <label class="form-label small fw-semibold mb-1">Min Exp (yrs)</label>
                <input type="number" step="0.5" min="0" name="minExp" value="@Model.MinExperience" class="form-control form-control-sm" placeholder="e.g. 2" />
            </div>

            <div class="col-6 col-sm-3 col-md-2 col-lg-2">
                <label class="form-label small fw-semibold mb-1">Max Exp (yrs)</label>
                <input type="number" step="0.5" min="0" name="maxExp" value="@Model.MaxExperience" class="form-control form-control-sm" placeholder="e.g. 5" />
            </div>

            <div class="col-12 col-sm-6 col-md-2 col-lg-2">
                <label class="form-label small fw-semibold mb-1">Sort By</label>
                <select name="sortBy" class="form-select form-select-sm">
                    <option value="date" selected="@(Model.SortBy == "date")">Date Captured</option>
                    <option value="score" selected="@(Model.SortBy == "score")">Match Score</option>
                    <option value="salary" selected="@(Model.SortBy == "salary")">Salary</option>
                </select>
            </div>

            <div class="col-12 col-sm-6 col-md-2 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Reset filters">Reset</a>
            </div>
        </form>
    </div>
</div>

@if (Model.UnrankedCount > 0 && (Model.SortBy == "score" || Model.SortBy == "salary"))
{
    <div class="alert alert-info py-2 small mb-3">
        <strong>Notice (BR-10):</strong> @Model.UnrankedCount posting@(Model.UnrankedCount == 1 ? "" : "s") with unstated/unmeasurable @(Model.SortBy == "score" ? "match score" : "salary") are placed at the end of the sorted list rather than treated as zero.
    </div>
}

@if (Model.Postings.Count == 0)
{
    <div class="text-center border rounded p-5 bg-light">
        <p class="mb-3 text-muted">
            @(Model.IncludeArchived
                ? "No matching postings found."
                : "Nothing here. Saved postings will appear in this list.")
        </p>
        <a class="btn btn-primary btn-sm" asp-action="Create">Add a posting</a>
    </div>
}
else
{
    <div class="table-responsive card border-0 shadow-sm">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Reference</th>
                    <th scope="col">Role &amp; Company</th>
                    <th scope="col">Details</th>
                    <th scope="col">Match Score</th>
                    <th scope="col">Application Status</th>
                    <th scope="col">Captured</th>
                    <th scope="col" class="text-end"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var posting in Model.Postings)
            {
                <tr class="@(posting.IsArchived ? "opacity-50 table-light" : null)">
                    <td class="text-nowrap font-monospace small">
                        <a asp-action="Details" asp-route-id="@posting.Id" class="fw-bold text-decoration-none">
                            @posting.Reference
                        </a>
                        @if (posting.IsArchived)
                        {
                            <span class="badge text-bg-secondary ms-1">Archived</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@posting.Id" class="text-decoration-none text-dark fw-semibold d-block">
                            @(posting.JobTitle ?? posting.Preview)
                        </a>
                        <div class="small text-muted">
                            @(posting.CompanyName ?? "Company unstated")
                        </div>
                    </td>
                    <td class="small">
                        @if (!string.IsNullOrWhiteSpace(posting.Location))
                        {
                            <div><span class="text-muted">Loc:</span> @posting.Location</div>
                        }
                        @if (posting.RemotePolicy.HasValue)
                        {
                            <span class="badge bg-light text-dark border">@posting.RemotePolicy.Value</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(posting.SalaryText))
                        {
                            <div class="text-success fw-semibold">@posting.SalaryText</div>
                        }
                    </td>
                    <td>
                        @if (posting.OverallScore.HasValue)
                        {
                            <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle fs-6 px-2 py-1">
                                @posting.OverallScore.Value.ToString("0")%
                            </span>
                        }
                        else
                        {
                            <span class="badge text-bg-light border text-muted small">Not measurable</span>
                        }
                    </td>
                    <td>
                        @* FR-53: Application status selector *@
                        <div class="dropdown">
                            <button class="btn btn-sm dropdown-toggle py-1 px-2 border @(posting.ApplicationStatus == ApplicationStatus.Interview ? "btn-info text-dark" : posting.ApplicationStatus == ApplicationStatus.Applied ? "btn-primary" : posting.ApplicationStatus == ApplicationStatus.Rejected ? "btn-danger" : posting.ApplicationStatus == ApplicationStatus.Closed ? "btn-secondary" : "btn-light")"
                                    type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @posting.ApplicationStatus
                            </button>
                            <ul class="dropdown-menu">
                                @foreach (ApplicationStatus status in Enum.GetValues(typeof(ApplicationStatus)))
                                {
                                    <li>
                                        <form asp-action="SetApplicationStatus" method="post">
                                            <input type="hidden" name="id" value="@posting.Id" />
                                            <input type="hidden" name="applicationStatus" value="@status" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                            <button type="submit" class="dropdown-item @(posting.ApplicationStatus == status ? "active" : "")">
                                                @status
                                            </button>
                                        </form>
                                    </li>
                                }
                            </ul>
                        </div>
                    </td>
                    <td class="text-nowrap small text-muted">
                        @posting.CapturedAt.ToLocalTime().ToString("d MMM yyyy")
                    </td>
                    <td class="text-end text-nowrap">
                        <form asp-action="Archive" asp-route-id="@posting.Id" method="post" class="d-inline">
                            <input type="hidden" name="isArchived" value="@((!posting.IsArchived).ToString())" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary py-1 px-2">
                                @(posting.IsArchived ? "Restore" : "Archive")
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
