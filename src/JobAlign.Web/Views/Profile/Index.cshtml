@model JobAlign.Web.Models.Profile.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h1 class="h2 mb-1">My Profile</h1>
            <p class="text-muted mb-0">Keep your profile current so job matches stay meaningful.</p>
        </div>
        <div class="text-end">
            <div class="small text-muted">Total experience</div>
            <div class="fs-4 fw-semibold">@(Model.TotalExperienceYears?.ToString("0.##") ?? "Not recorded") years</div>
        </div>
    </div>

    @if (TempData["StatusMessage"] is string message)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @message
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-12 col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-header"><strong>Personal details</strong></div>
                <div class="card-body">
                    <form asp-action="UpdateDetails" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3"><label asp-for="Details.FullName" class="form-label"></label><input asp-for="Details.FullName" class="form-control" /></div>
                        <div class="mb-3"><label asp-for="Details.Headline" class="form-label"></label><input asp-for="Details.Headline" class="form-control" /></div>
                        <div class="mb-3"><label asp-for="Details.CurrentRole" class="form-label"></label><input asp-for="Details.CurrentRole" class="form-control" /></div>
                        <div class="mb-3"><label asp-for="Details.PhoneNumber" class="form-label"></label><input asp-for="Details.PhoneNumber" class="form-control" /></div>
                        <button class="btn btn-primary" type="submit">Save details</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-7">
            <div class="card shadow-sm h-100">
                <div class="card-header d-flex justify-content-between"><strong>Skills</strong><span class="badge text-bg-secondary">@Model.Skills.Count</span></div>
                <div class="card-body">
                    <form asp-action="AddSkill" method="post" class="row g-2 mb-3">
                        @Html.AntiForgeryToken()
                        <div class="col-md-6"><label class="visually-hidden" for="RawSkillText">Skill</label><input name="RawSkillText" id="RawSkillText" class="form-control" placeholder="e.g. c sharp" required /></div>
                        <div class="col-md-4"><label class="visually-hidden" for="ProficiencyLevel">Proficiency</label><select name="ProficiencyLevel" id="ProficiencyLevel" class="form-select" asp-items="Html.GetEnumSelectList<JobAlign.Core.Enums.ProficiencyLevel>()"></select></div>
                        <div class="col-md-2 d-grid"><button class="btn btn-primary" type="submit">Add</button></div>
                    </form>

                    @if (Model.Skills.Count == 0)
                    {
                        <p class="text-muted mb-0">No confirmed skills yet.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var skill in Model.Skills)
                            {
                                <div class="border rounded px-2 py-1 d-flex align-items-center gap-2">
                                    <span>@skill.CanonicalName</span>
                                    <span class="badge text-bg-light">@skill.ProficiencyLevel</span>
                                    <form asp-action="RemoveSkill" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@skill.Id" />
                                        <button type="submit" class="btn btn-sm btn-link text-danger p-0" title="Remove">×</button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header"><strong>Education</strong></div>
                <div class="card-body">
                    <form asp-action="AddEducation" method="post" class="row g-2 mb-4">
                        @Html.AntiForgeryToken()
                        <div class="col-md-3"><input name="Institution" class="form-control" placeholder="Institution" required /></div>
                        <div class="col-md-2"><input name="Qualification" class="form-control" placeholder="Qualification" /></div>
                        <div class="col-md-2"><input name="FieldOfStudy" class="form-control" placeholder="Field of study" /></div>
                        <div class="col-md-1"><input name="Grade" class="form-control" placeholder="Grade" /></div>
                        <div class="col-md-1"><input name="StartDate" type="date" class="form-control" /></div>
                        <div class="col-md-1"><input name="EndDate" type="date" class="form-control" /></div>
                        <div class="col-md-2 d-grid"><button class="btn btn-outline-primary">Add education</button></div>
                    </form>
                    @if (Model.Education.Count == 0) { <p class="text-muted">No education entries yet.</p> }
                    else {
                        <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Institution</th><th>Qualification</th><th>Field</th><th>Dates</th><th></th></tr></thead><tbody>
                        @foreach (var e in Model.Education) { <tr><td>@e.Institution</td><td>@e.Qualification</td><td>@e.FieldOfStudy</td><td>@e.StartDate?.ToString("MMM yyyy") – @e.EndDate?.ToString("MMM yyyy")</td><td class="text-end"><form asp-action="RemoveEducation" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.Id" /><button class="btn btn-sm btn-outline-danger">Remove</button></form></td></tr> }
                        </tbody></table></div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header"><strong>Work experience</strong></div>
                <div class="card-body">
                    <form asp-action="AddExperience" method="post" class="row g-2 mb-4">
                        @Html.AntiForgeryToken()
                        <div class="col-md-2"><input name="CompanyName" class="form-control" placeholder="Company" required /></div>
                        <div class="col-md-2"><input name="JobTitle" class="form-control" placeholder="Job title" required /></div>
                        <div class="col-md-3"><input name="Description" class="form-control" placeholder="Description" /></div>
                        <div class="col-md-2"><input name="StartDate" type="date" class="form-control" /></div>
                        <div class="col-md-2"><input name="EndDate" type="date" class="form-control" /></div>
                        <div class="col-md-1 form-check d-flex align-items-center"><input name="IsCurrent" value="true" type="checkbox" class="form-check-input me-1" />Current</div>
                        <div class="col-12"><button class="btn btn-outline-primary">Add experience</button></div>
                    </form>
                    @if (Model.WorkExperience.Count == 0) { <p class="text-muted">No work experience recorded.</p> }
                    else {
                        <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Company</th><th>Role</th><th>Dates</th><th></th></tr></thead><tbody>
                        @foreach (var e in Model.WorkExperience) { <tr><td>@e.CompanyName</td><td>@e.JobTitle</td><td>@e.StartDate?.ToString("MMM yyyy") – @(e.IsCurrent ? "Present" : e.EndDate?.ToString("MMM yyyy"))</td><td class="text-end"><form asp-action="RemoveExperience" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.Id" /><button class="btn btn-sm btn-outline-danger">Remove</button></form></td></tr> }
                        </tbody></table></div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header"><strong>Projects</strong></div>
                <div class="card-body">
                    <form asp-action="AddProject" method="post" class="row g-2 mb-3">
                        @Html.AntiForgeryToken()
                        <div class="col-12"><input name="Name" class="form-control" placeholder="Project name" required /></div>
                        <div class="col-12"><textarea name="Description" class="form-control" placeholder="Description" rows="2"></textarea></div>
                        <div class="col-8"><input name="Url" class="form-control" placeholder="Project URL" /></div>
                        <div class="col-4"><button class="btn btn-outline-primary w-100">Add</button></div>
                    </form>
                    @if (Model.Projects.Count == 0) { <p class="text-muted">No projects yet.</p> }
                    else { <ul class="list-group list-group-flush">@foreach (var p in Model.Projects) { <li class="list-group-item px-0 d-flex justify-content-between gap-3"><div><strong>@p.Name</strong><div class="small text-muted">@p.Description</div></div><form asp-action="RemoveProject" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id" /><button class="btn btn-sm btn-outline-danger">Remove</button></form></li> }</ul> }
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header"><strong>Certifications</strong></div>
                <div class="card-body">
                    <form asp-action="AddCertification" method="post" class="row g-2 mb-3">
                        @Html.AntiForgeryToken()
                        <div class="col-12"><input name="Name" class="form-control" placeholder="Certification name" required /></div>
                        <div class="col-6"><input name="IssuingOrganization" class="form-control" placeholder="Issuer" /></div>
                        <div class="col-6"><input name="CredentialId" class="form-control" placeholder="Credential ID" /></div>
                        <div class="col-6"><input name="IssuedOn" type="date" class="form-control" /></div>
                        <div class="col-6"><input name="ExpiresOn" type="date" class="form-control" /></div>
                        <div class="col-12"><button class="btn btn-outline-primary">Add certification</button></div>
                    </form>
                    @if (Model.Certifications.Count == 0) { <p class="text-muted">No certifications yet.</p> }
                    else { <ul class="list-group list-group-flush">@foreach (var c in Model.Certifications) { <li class="list-group-item px-0 d-flex justify-content-between gap-3"><div><strong>@c.Name</strong><div class="small text-muted">@c.IssuingOrganization</div></div><form asp-action="RemoveCertification" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.Id" /><button class="btn btn-sm btn-outline-danger">Remove</button></form></li> }</ul> }
                </div>
            </div>
        </div>
    </div>
</div>
